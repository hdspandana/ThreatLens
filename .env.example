# --- Database (required) ------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- LLM explanation layer (optional) ------------------------------------
# If unset, ThreatLens falls back to a deterministic, template-based
# explanation and the rest of the app remains fully functional.
OPENAI_API_KEY=
THREATLENS_LLM_ENABLED=true
THREATLENS_LLM_MODEL=gpt-4o-mini
THREATLENS_LLM_BASE_URL=https://api.openai.com/v1
THREATLENS_LLM_TIMEOUT_MS=20000

# --- Evidence storage ------------------------------------------------
THREATLENS_STORAGE_DIR=storage/evidence
THREATLENS_MAX_UPLOAD_BYTES=10485760

# --- OCR ------------------------------------------------
THREATLENS_OCR_ENABLED=true
THREATLENS_OCR_LANGDATA_DIR=data/tessdata
THREATLENS_OCR_LANGUAGE=eng
THREATLENS_OCR_LOW_CONFIDENCE=65

# --- Risk engine thresholds (0-10 interpretable score) ------------------------------------------------
THREATLENS_RISK_MEDIUM_THRESHOLD=2.5
THREATLENS_RISK_HIGH_THRESHOLD=5
THREATLENS_RISK_CRITICAL_THRESHOLD=8
THREATLENS_MIN_TEXT_LENGTH=3

# --- Retrieval ------------------------------------------------
THREATLENS_RETRIEVAL_ENABLED=true
THREATLENS_RETRIEVAL_TOP_K=3
THREATLENS_KB_DIR=data/knowledge_base
THREATLENS_RETRIEVAL_MIN_SIMILARITY=0.03

# Structured, content-free logging level: info | warn | error | silent
THREATLENS_LOG_LEVEL=info
